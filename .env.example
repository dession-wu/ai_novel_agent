# ===== AI Novel Agent 部署环境变量（docker compose 使用） =====
# 使用方法：cp .env.example .env 后按需修改，切勿提交真实密钥到仓库
# compose 中变量带默认值，最小可用配置只需填写 SECRET_KEY 与 OPENAI_API_KEY

# --- 必填 ---
# JWT 签名与 AES 加密密钥派生用，生产必须换强随机值
# 生成方式：openssl rand -hex 32
SECRET_KEY=

# OpenAI / LLM 设置
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo-preview

# --- 可选（以下均有 compose 默认值） ---
# 运行环境：production 时 SECRET_KEY 若为开发默认值会拒绝启动
ENVIRONMENT=production

# 数据库（容器内服务名 db，宿主机不映射 5432 端口）
POSTGRES_PASSWORD=
# DATABASE_URL 由 compose 自动拼装，一般无需手动设置
# DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/novel_agent

# CORS 白名单（JSON 数组格式，也兼容逗号分隔）。默认同源 /api 反代方案下浏览器不跨域，
# 留默认即可；将来切独立 API 域名时在此加入前端域名
CORS_ORIGINS=["http://localhost:8081"]

# 前端构建时注入的 API 基址：默认同源相对路径 /api/v1（推荐），
# 仅在前后端分域部署时才需要改成绝对地址，如 https://api.example.com/api/v1
VITE_API_BASE_URL=/api/v1

# --- 本地开发（非容器）时使用，容器部署无需关心 ---
PROJECT_NAME="AI Novel Agent"
API_V1_STR="/api/v1"
POSTGRES_SERVER="localhost"
POSTGRES_USER="postgres"
POSTGRES_DB="novel_agent"
DATABASE_URL="postgresql://postgres:${POSTGRES_PASSWORD}@localhost/novel_agent"
CHROMA_PERSIST_DIRECTORY="./chroma_db"