{
  "name": "local-ai-novel-agent",
  "networks": {
    "default": {
      "name": "ai_novel_agent_default",
      "ipam": {}
    }
  },
  "services": {
    "backend": {
      "restart": "unless-stopped",
      "command": [
        "sh",
        "-c",
        "python -m app.init_db && uvicorn main:app --host 0.0.0.0 --port 8000"
      ],
      "entrypoint": null,
      "environment": {
        "CHROMA_PERSIST_DIRECTORY": "/data/chroma",
        "CORS_ORIGINS": "[\"https://novel.podnotes.cloud\",\"http://localhost:8081\"]",
        "DATABASE_URL": "${DATABASE_URL}",
        "ENVIRONMENT": "production",
        "OPENAI_API_KEY": "${OPENAI_API_KEY}",
        "OPENAI_MODEL": "gpt-4-turbo-preview",
        "SECRET_KEY": "${SECRET_KEY}"
      },
      "networks": {
        "default": null
      },
      "build": {
        "context": "../..",
        "dockerfile": "Dockerfile.local"
      },
      "depends_on": {
        "db": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "curl -fsS http://localhost:8000/ || exit 1"
        ],
        "timeout": "5s",
        "interval": "15s",
        "retries": 5,
        "start_period": "40s"
      },
      "volumes": [
        {
          "type": "volume",
          "source": "chroma_data",
          "target": "/data/chroma",
          "volume": {}
        },
        "./runtime/private:/app/private"
      ]
    },
    "db": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "environment": {
        "POSTGRES_DB": "novel_agent",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      },
      "image": "postgres:15",
      "networks": {
        "default": null
      },
      "volumes": [
        {
          "type": "volume",
          "source": "pgdata",
          "target": "/var/lib/postgresql/data",
          "volume": {}
        }
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -d novel_agent"
        ],
        "timeout": "5s",
        "interval": "5s",
        "retries": 12
      }
    },
    "frontend": {
      "restart": "unless-stopped",
      "command": null,
      "entrypoint": null,
      "networks": {
        "default": null
      },
      "build": {
        "context": "../../frontend",
        "dockerfile": "Dockerfile.local",
        "args": {
          "VITE_API_BASE_URL": "/api/v1"
        }
      },
      "depends_on": {
        "backend": {
          "condition": "service_healthy",
          "required": true
        }
      },
      "ports": [
        {
          "mode": "ingress",
          "target": 80,
          "published": "8081",
          "protocol": "tcp",
          "host_ip": "127.0.0.1"
        }
      ]
    }
  },
  "volumes": {
    "chroma_data": {
      "name": "ai_novel_agent_chroma_data"
    },
    "pgdata": {
      "name": "ai_novel_agent_pgdata"
    }
  }
}
