# Frontend environment (Vite)
# Copy to .env.local and adjust as needed. Variables prefixed with VITE_ are
# embedded into the frontend bundle at build time (must be public-safe values).

# Base URL of the backend API.
# Same-origin relative path (recommended, works in both dev proxy and the
# production nginx container which reverse-proxies /api to the backend):
#   VITE_API_BASE_URL=/api/v1
# Absolute URL (only for split-domain deployments):
#   VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1